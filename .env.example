# Copy to .env and fill in. Names only here; never commit values. `make run` generates
# the two platform tokens below when they are empty.

# Platform secrets (generated by make run if empty). PROJECT_TOKEN_KEY encrypts the git
# tokens of the projects created in the UI; losing it means entering every token again.
OPENCLAW_GATEWAY_TOKEN=
YUNO_MCP_TOKEN=
PROJECT_TOKEN_KEY=

# Model provider. MODEL_UPSTREAM is anthropic | openrouter. With anthropic, set
# ANTHROPIC_API_KEY; with openrouter, set OPENROUTER_API_KEY (OpenRouter serves the same
# Claude models under anthropic/claude-x.y ids; the proxy maps them). Leave the key empty
# to run with the deterministic scripted provider only (tests and evals work without
# it). The key is held by the api only; the OpenClaw container never sees it.
MODEL_UPSTREAM=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
DEFAULT_MODEL=claude-opus-5-5
MODEL_PROXY_RATE_PER_MINUTE=60

# Telegram, through OpenClaw's native channel. TELEGRAM_MODE is off | polling | webhook.
# Webhook mode needs PUBLIC_BASE_URL (make tunnel prints one) and a secret >= 32 chars.
# TELEGRAM_ALLOWED_USER_IDS: comma-separated numeric Telegram user ids allowed to chat
# and to approve actions.
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_IDS=
PUBLIC_BASE_URL=

# Optional GitLab merge-request tool. All three must be set to register the tool.
GITLAB_BASE_URL=
GITLAB_PROJECT_ID=
GITLAB_TOKEN=

# Project bootstrap (README "Projects"): projects are created and edited on the Projects
# page; these settings only create the first one, once, at the api's first start with
# them set (an install that predates the page). PROJECT_REPO_URL is the https clone URL
# without credentials; PROJECT_GIT_TOKEN is a token with write access (GitLab: api +
# write_repository; GitHub: contents + pull requests), held by the api only and never
# shown to an agent; PROJECT_PROVIDER is gitlab | github (empty: github for github.com,
# gitlab otherwise). PROJECT_SANDBOX_NETWORK=true gives the sandboxes of runs on this
# project network access so agents can install the project's dependencies themselves;
# off, the run still clones and agents work with what the image has. Network on is for
# trusted repositories only (docs/threat-model.md). After the bootstrap, edit the
# project on the page: these values are not read again.
PROJECT_REPO_URL=
PROJECT_GIT_TOKEN=
PROJECT_DEFAULT_BRANCH=main
PROJECT_PROVIDER=
PROJECT_SANDBOX_NETWORK=false

# API and engine. API_TOKEN empty means no auth (local use).
API_TOKEN=
WEB_PORT=8080
POSTGRES_PORT=5432
ENGINE_WORKERS=4
MCP_TOOL_WAIT_SECONDS=540
# SCHEDULER_TICK: how often the scheduler looks for due schedules (Go duration)
SCHEDULER_TICK=10s
HTTP_FETCH_ALLOWLIST=docs.python.org,pypi.org,raw.githubusercontent.com
LOG_LEVEL=info

# Docker socket the gateway uses to create agent sandboxes (rootless: /run/user/1000/docker.sock)
DOCKER_SOCKET=/var/run/docker.sock

# ---- Every other setting the api reads, with its default (names only, no secrets) ----

# Engine limits (platform maxima; per-run limits are clamped to these)
#ENGINE_STALE_AFTER=300s
#MAX_STEPS=200
#MAX_DURATION_SECONDS=3600
#MAX_NODE_ITERATIONS=50
#MAX_LOOP_VISITS=10
#MAX_COST_USD=20
#MAX_TOOL_CALLS=300
#APPROVAL_TIMEOUT_MAX_SECONDS=604800

# Deploy target (the local release store deploy_release publishes to)
#DEPLOYTARGET_URL=http://localhost:8091
#DEPLOYTARGET_LISTEN=:8091
#DEPLOYTARGET_DATA_DIR=/tmp/yuno-releases
#DEPLOYTARGET_MAX_MB=100

# Evaluation runner
#EVAL_API_URL=http://127.0.0.1:8080
#EVAL_PROVIDER=scripted
#EVAL_SPLIT=public
#EVAL_CASES_DIR=evals/cases
#EVAL_REPORTS_DIR=evals/reports

# OpenClaw gateway (set by compose; override only for a different layout)
#OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
#OPENCLAW_STATE_DIR=/home/node/.openclaw
#OPENCLAW_SANDBOX_IMAGE=yuno-sandbox:latest
#API_BASE_FOR_OPENCLAW=http://127.0.0.1:8080

# Listeners, database, tool output
#DATABASE_URL=postgres://yuno:yuno@localhost:5432/yuno?sslmode=disable
#LISTEN_ADDR=:8080
#TOOL_OUTPUT_MAX_BYTES=32768

# Public deployment (docs/deploy.md). DOMAIN is the hostname Caddy obtains a certificate
# for; on a public host bind the plain-http port to loopback and activate the profile so
# every make target sees caddy. PUBLIC_BASE_URL is then https://DOMAIN.
DOMAIN=
WEB_BIND=
COMPOSE_PROFILES=
